{
  "name": "@luxuride-pi/blender",
  "version": "0.1.5",
  "description": "pi extension: Blender integration (live Blender session, render, scene inspection) with flatpak support",
  "keywords": [
    "blender",
    "bpy",
    "pi-extension",
    "pi-package",
    "subagent"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "license": "MIT",
  "files": [
    "index.ts",
    "config.ts",
    "launch.ts",
    "manager-core.ts",
    "core/",
    "blender/",
    "scripts/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "setup": "node scripts/dev-setup.mjs",
    "check:setup": "node scripts/dev-setup.mjs --check",
    "install:agents": "node scripts/install-agents.mjs",
    "check:agents": "node scripts/install-agents.mjs --check",
    "mcp": "node scripts/mcp-server.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@luxuride-pi/manager-core": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxuride-pi-extensions/pi-blender.git"
  }
}
