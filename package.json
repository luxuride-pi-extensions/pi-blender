{
	"name": "pi-vibe-blender",
	"version": "0.1.3",
	"description": "pi extension: Vibe Blender integration (live Blender session, render, scene inspection) with flatpak support",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lux-vibe/pi-vibe-blender.git"
	},
	"keywords": [
		"pi-extension",
		"blender",
		"bpy",
		"subagent"
	],
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"setup": "node scripts/dev-setup.mjs",
		"check:setup": "node scripts/dev-setup.mjs --check",
		"install:agents": "node scripts/install-agents.mjs",
		"check:agents": "node scripts/install-agents.mjs --check"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@types/node": "^22.0.0",
		"typebox": "^1.3.27",
		"typescript": "^5.6.0"
