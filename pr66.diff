+		};
+
+		pruneRevertedGenerations(current, { name: "mug", sequence: 2 });
+
+		assert.deepEqual(
+			current.branchRuns.map((run) => `${run.sequence}:${run.status}`),
+			["2:staged"],
+		);
+	});
